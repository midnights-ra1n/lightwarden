{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightwarden",
  "mainBinaryName": "lightwarden",
  "version": "0.2.0",
  "identifier": "app.lightwarden",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Lightwarden", "width": 1240, "height": 780, "minWidth": 880, "minHeight": 560, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
